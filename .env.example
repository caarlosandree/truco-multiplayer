# Copie para .env e ajuste. O .env não é versionado.
# POSTGRES_PORT=5433  # porta do host para o Postgres do compose, se a 5432 estiver ocupada (ajuste DATABASE_URL junto). Não é lida pelo .env: o make dev-db recebe pelo ambiente do shell, ex.: POSTGRES_PORT=5433 make dev-db
DATABASE_URL=postgres://truco:truco@localhost:5432/truco?sslmode=disable
HTTP_ADDR=:8080
# Origem pública do app (sem caminho). No dev, a do Vite: http://localhost:5173
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=true
TRUST_PROXY=false
# Lista separada por vírgula; só popula a tabela de domínios se ela estiver vazia.
ALLOWED_EMAIL_DOMAINS=empresa.com.br
# log escreve os e-mails (com os links) no log, para quem clona sem chave do Resend.
# Em produção use resend (o padrão quando a variável não está definida) e preencha RESEND_API_KEY.
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM="Truco <truco@empresa.com.br>"
RANKING_MIN_MATCHES=5
MIGRATE_ON_START=true
LOG_LEVEL=info
LOG_FORMAT=text
STATIC_DIR=

# Salas (Spec 3). Tempos em segundos.
TIMER_PLAY_SECONDS=30
TIMER_VOTE_SECONDS=20
TIMER_CHOICE_SECONDS=15
TIMER_BURN_SECONDS=15
# Prazo de decisão de um jogador ausente (desconectado ou com 3 timeouts seguidos).
TIMER_ABSENT_SECONDS=5
HAND_PAUSE_SECONDS=4
# W.O. fica disponível após este tempo ausente seguido ou após o orçamento acumulado na partida.
ABSENCE_GRACE_SECONDS=120
ABSENCE_BUDGET_SECONDS=300
WAITING_DISCONNECT_SECONDS=60
MAX_ROOMS=50
SHUTDOWN_TIMEOUT_SECONDS=15

# Bots (Spec 5). Tempos em milissegundos.
# Tempo máximo de cálculo por decisão do bot (50..5000).
BOT_THINK_BUDGET_MS=800
# Cálculos de bot simultâneos no processo (1..64). Se ausente, usa o número de CPUs.
# BOT_MAX_CONCURRENT=4
# Pausa de "pensar" antes de o bot agir: sorteada entre o mínimo e o máximo (0..10000, máx >= mín).
BOT_DELAY_MIN_MS=1000
BOT_DELAY_MAX_MS=3000
